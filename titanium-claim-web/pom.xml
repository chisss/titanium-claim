<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.titanium</groupId>
        <artifactId>titanium-claim</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>titanium-claim-web</artifactId>
    <name>titanium-claim-web</name>
    <description>理赔服务Web模块</description>

    <dependencies>
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-claim-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-claim-application</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <!-- 查询层：web mapper 映射 query result → response/VO -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-claim-query</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <!-- 通用层：提供 TenantContext（多租户横切） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-claim-common</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- mapstruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 租户请求上下文 RequestContextHolder（g07-02c：目录 Provider 从 X-Tenant-Id 取租户，
             与 ClaimApiProvider/ClaimController 同一取法；此前仅靠 claim-query 传递可得） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-common</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- g07-02c：契约实现（Provider）单元测试用；Mapping 用 MapStruct 生成的实现类，不引 Spring 上下文 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    
        <!-- m27-01/PKG-01：显式声明实际使用的内核/starter 模块（原经 titanium-common 传递获得） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-kernel</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <!-- m27-01/PKG-01：显式声明实际使用的内核/starter 模块（原经 titanium-common 传递获得） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-starter-web</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>